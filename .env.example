# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Alternatively, NEXT_PUBLIC_SUPABASE_ANON_KEY can also be used:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (Required for Superadmin Full Global Database Backup & Restore across all users)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Application Settings
NEXT_PUBLIC_APP_NAME=PocketLog
NEXT_PUBLIC_DEFAULT_CURRENCY=IDR

# Trusted Device Secret Token (access URL?device=your-token to register device without a database table)
# Supports single token or comma-separated tokens: e.g. your-secure-token-1,your-secure-token-2
TRUSTED_DEVICE_TOKEN=your-trusted-device-secret-token

# Session & Cookie Derivation Secret (Optional - fallback provided if omitted)
SESSION_SECRET=your-random-session-secret

# Session Lifetime & Expiration (Default: 86400 seconds = 1 day)
# Supports seconds (86400), hours (24h), or days (1d)
SESSION_EXPIRATION_SECONDS=86400
NEXT_PUBLIC_SESSION_EXPIRATION_SECONDS=86400

# Web Push Notification VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@pocketlog.app

# Cron Secret for automated reminders
CRON_SECRET=your-cron-secret-token
